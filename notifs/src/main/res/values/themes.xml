<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bar_bg">#FFFFFF</color>
    <color name="bar_fg">#6B6B6B</color>
    <color name="bar_active">#111111</color>
    <color name="accent">#7C5CFF</color>
    <color name="icon_bg">#3D2C8D</color>

    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/bar_bg</item>
        <item name="android:navigationBarColor">@color/bar_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bar_bg</item>
    </style>
</resources>
